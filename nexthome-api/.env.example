# Copy to .env and fill in. Validated at boot by src/lib/env.js (assertEnv):
# the server refuses to start if a required variable is missing or invalid.
#
# Legend:  [ALWAYS]  required in every environment
#          [PROD]    required when NODE_ENV=production
#          [OPTIONAL]

# [ALWAYS] PostgreSQL connection string.
# Local:   postgresql://postgres:postgres@localhost:5432/nexthome?schema=public
# Railway: the connection string from the Postgres plugin's "Connect" tab.
DATABASE_URL=

# [ALWAYS] Signs access tokens and pre-registration phone proofs. In
# production it must be >= 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=

# [ALWAYS] Public URL of the frontend: http(s)://..., no trailing slash.
# Used for emailed links (/verify-email, /reset-password) and is
# automatically added to the CORS allowlist.
FRONTEND_URL=http://localhost:3000

# [PROD] Must be exactly "production" on Railway. It switches on the stricter
# checks below, Secure cookies, and the S3-only upload path. If it is left
# unset, none of those protections apply.
NODE_ENV=development

# [PROD] Email via Brevo's HTTP API. Without BREVO_API_KEY in development,
# emails are logged to the console instead of sent.
BREVO_API_KEY=
EMAIL_FROM=NextHome <no-reply@yourdomain.com>

# [PROD] File uploads (S3). All four or none; "none" is rejected in
# production because the local-disk fallback is wiped on every deploy. Must
# match next.config.ts images.remotePatterns on the frontend
# (<bucket>.s3.<region>.amazonaws.com) or uploaded photos/ads won't render.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# [OPTIONAL]
PORT=4000
JWT_ACCESS_EXPIRES_IN=15m
# Refresh cookie SameSite: lax | strict | none. Default: none in production
# (frontend and API on different sites, e.g. vercel.app + railway.app), lax
# otherwise. Set to lax once the API is on a subdomain of the frontend's own
# domain.
REFRESH_COOKIE_SAMESITE=

# [OPTIONAL] Phone OTP. Termii for Nigerian numbers, Twilio for the rest.
# If neither is configured the OTP is logged to the server console (see
# src/lib/sms.js) — fine for staging, not for real users.
TERMII_API_KEY=
TERMII_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
